# The source archive is the companion to the wheel: documentation, tests and examples.
include .gitignore CHANGELOG.md architecture.md requirements.md install.sh
recursive-include docs *.md *.py
recursive-include docs/_static *.png *.css *.json
recursive-include examples *.toml *.tex *.bib
recursive-include src/latexprep/presets *.toml
include src/latexprep/loaded_options_hook.tex
include src/latexprep/report.css
recursive-include tests *.py
recursive-include tests/golden *.txt *.json *.html
recursive-include scripts *.py
prune docs/_build
recursive-include skills *.md
