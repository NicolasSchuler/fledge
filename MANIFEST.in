# The source archive is the companion to the wheel: documentation, tests and examples.
include .gitignore architecture.md requirements.md install.sh
recursive-include docs *.md *.py
recursive-include docs/_static *.png *.css
recursive-include examples *.toml *.tex *.bib
recursive-include tests *.py
include scripts/benchmark_parallelism.py
prune docs/_build
recursive-include skills *.md
